Algoritmo ejercicio1_acumuladores
	
	Definir i, num, acumulador Como Entero
	
	acumulador=0
	
	Para i=0 hasta 2 con paso 1 Hacer
		Escribir "Dime el número " i+1 " para realizar la operacíon"
		Leer num
		acumulador = acumulador + num 
	FinPara
	
	Escribir "La suma de los tres números es " acumulador
	
FinAlgoritmo
